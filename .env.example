# GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Google Service Account (GCP)
SHEET_ID=your_google_sheet_id
ECO_LEADS_SHEET_ID=your_eco_leads_sheet_id
GOOGLE_CLIENT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Meeting Scheduling Settings
GOOGLE_CALENDAR_ID=your_google_calendar_id
MEETING_SHEET_ID=your_meeting_sheet_id_or_leave_same_as_SHEET_ID

# Nodemailer / SMTP Info
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Preet Tech <hello@preettech.com>"

# Optional Base URL override
NEXT_PUBLIC_APP_URL=http://localhost:3000/

# Protects the Publish API webhook from being triggered by strangers
ADMIN_NOTIFY_SECRET=your_super_secret_password

# Hygraph Credentials
HYGRAPH_ENDPOINT=your_hygraph_endpoint
HYGRAPH_TOKEN=your_hygraph_token
